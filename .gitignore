# ---------------------------------------------------------------------------
*.swp
*.swo
*~
\#*\#
.\#*
.vscode/
.idea/
*.sublime-*

.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

